# ===== VendorDesk environment variables =====
# Copy this file to .env.local and fill in your values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Paystack (Settings → API Keys & Webhooks) ---
# Leave empty while testing — the app works WhatsApp-only without it.
# Test keys start with sk_test_ / pk_test_, live keys with sk_live_ / pk_live_
PAYSTACK_SECRET_KEY=
